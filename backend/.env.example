# Скопируйте этот файл в .env и при необходимости заполните значения.
# Все ключи внешних API необязательны: без них поиск работает
# через Википедию и iTunes Search API (ключи не нужны) и по локальному каталогу.

# База данных: по умолчанию SQLite-файл backend/kinodnevnik.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/kinodnevnik

# Секретный ключ для подписи JWT — замените на случайную строку
SECRET_KEY=change-me-please-32-characters-min

# ПоискКино (данные и рейтинг Кинопоиска, постеры): бесплатный токен выдаёт Telegram-бот
# @poiskkinodev_bot (https://poiskkino.dev/), 200 запросов в сутки
POISKKINO_API_KEY=

# TMDB: API Key (v3) или API Read Access Token (v4) — https://www.themoviedb.org/settings/api
# (регистрация → Настройки → API → создать ключ, тип Developer)
TMDB_API_KEY=

# OMDb (рейтинг IMDb): бесплатный ключ — https://www.omdbapi.com/apikey.aspx,
# после регистрации активируйте ключ по ссылке из письма
OMDB_API_KEY=

# Витрина iTunes Search API (us, ru, gb…)
ITUNES_COUNTRY=us

# Сброс демо-базы к исходным данным каждые N минут (0 — не сбрасывать; в публичном демо на Vercel — 30)
DEMO_RESET_MINUTES=0
